-- FUNCTION: public.cotizar_poliza7(integer, integer[], integer, integer, integer, integer, text, text, boolean, integer)

-- DROP FUNCTION IF EXISTS public.cotizar_poliza7(integer, integer[], integer, integer, integer, integer, text, text, boolean, integer);

CREATE OR REPLACE FUNCTION public.cotizar_poliza7(
	p_cantidad_viajeros integer,
	p_edades integer[],
	p_id_pais_origen integer,
	p_tipo_destino integer,
	p_id_destino integer,
	p_cantidad_dias integer,
	p_telefono text,
	p_email text,
	p_multiviaje boolean,
	p_dias_seguidos_multi integer DEFAULT 0)
    RETURNS TABLE(id_plan integer, nombre_plan character varying, precio_total numeric, simbolo_moneda character varying, descripcion_cobertura character varying, imagen character varying, valor_descuento numeric, nombre_destino character varying) 
    LANGUAGE 'plpgsql'
    COST 100
    VOLATILE PARALLEL UNSAFE
    ROWS 1000

AS $BODY$
DECLARE
    v_tipo_cambio numeric := 1;
BEGIN

    -- Obtener tipo de cambio
    SELECT valor::numeric
    INTO v_tipo_cambio
    FROM t_tipo_cambio
    WHERE id_pais = p_id_pais_origen;

    IF NOT FOUND THEN
        v_tipo_cambio := 1;
    END IF;

    RETURN QUERY

    WITH planes_filtrados AS (
        SELECT 
            pl.id_plan,
            pl.nombre_plan,
            pl.descripcion_cobertura,
            pl.imagen_plan_ruta
        FROM t_plan pl
        WHERE pl.tipo_usuario = 'REGULAR'
        AND (
            (p_tipo_destino = 0 AND EXISTS (
                SELECT 1
                FROM t_detalle_plan_destino dpd
                WHERE dpd.id_plan = pl.id_plan
                  AND dpd.id_destino = p_id_destino
            ))
            OR
            (p_tipo_destino = 1 AND EXISTS (
                SELECT 1
                FROM t_plan_paises pp
                WHERE pp.id_plan = pl.id_plan
                  AND pp.id_pais = p_id_destino
            ))
        )
    ),

    bloque_base AS (

        -- Precio base (igual que buscarPrecioAnterior en Java)
        SELECT
            pr.id_plan,
            pf.nombre_plan,
            pf.descripcion_cobertura,
            pf.imagen_plan_ruta,
            pr.duracion,
            pr.precio_individual::numeric,
            pr.precio_mayor_setenta::numeric,

            -- Buscar siguiente tramo consecutivo (igual que buscarPrecioMayorConsecutivo)
            (
                SELECT pr2.duracion
                FROM t_precios pr2
                WHERE pr2.id_plan = pr.id_plan
                  AND pr2.duracion > pr.duracion
                ORDER BY pr2.duracion ASC
                LIMIT 1
            ) AS duracion_siguiente,

            (
                SELECT pr2.precio_individual::numeric
                FROM t_precios pr2
                WHERE pr2.id_plan = pr.id_plan
                  AND pr2.duracion > pr.duracion
                ORDER BY pr2.duracion ASC
                LIMIT 1
            ) AS precio_siguiente

        FROM t_precios pr
        JOIN planes_filtrados pf ON pf.id_plan = pr.id_plan
        WHERE pr.flag_multiviajes IS NULL
          AND pr.duracion = (
                SELECT MAX(pr3.duracion)
                FROM t_precios pr3
                WHERE pr3.id_plan = pr.id_plan
                  AND pr3.duracion <= p_cantidad_dias
          )
    ),

    calculo_interpolado AS (
        SELECT
            bb.*,
            GREATEST(0, p_cantidad_dias - bb.duracion) AS dias_excedentes,

            -- Interpolación lineal (igual que Java)
            (
                bb.precio_individual
                +
                COALESCE(
                    (
                        (bb.precio_siguiente - bb.precio_individual)
                        /
                        NULLIF((bb.duracion_siguiente - bb.duracion)::numeric,0)
                    ) 
                    * GREATEST(0, p_cantidad_dias - bb.duracion),
                    0
                )
            ) AS tarifa_base
        FROM bloque_base bb
    ),

    calculo_pax AS (
        SELECT
            ci.*,
            COUNT(*) FILTER (WHERE e <= 70) AS menor_70,
            COUNT(*) FILTER (WHERE e > 70)  AS mayor_70
        FROM calculo_interpolado ci
        CROSS JOIN unnest(p_edades) AS e
        GROUP BY
            ci.id_plan,
            ci.nombre_plan,
            ci.descripcion_cobertura,
            ci.imagen_plan_ruta,
            ci.duracion,
            ci.precio_individual,
            ci.precio_mayor_setenta,
            ci.duracion_siguiente,
            ci.precio_siguiente,
            ci.dias_excedentes,
            ci.tarifa_base
    )

    SELECT
    cp.id_plan::integer,
    cp.nombre_plan::varchar,

    ROUND(
        (
            (cp.tarifa_base * cp.menor_70)
            +
            (cp.tarifa_base * cp.mayor_70)
            +
            (
                cp.tarifa_base
                * (cp.precio_mayor_setenta / 100)
                * cp.mayor_70
            )
        )
        * v_tipo_cambio
    , 2)::numeric AS precio_total,

    '$'::varchar,   -- 🔥 FIX AQUÍ

    cp.descripcion_cobertura::varchar,

    ('https://star-assist.biz/resources/img/' || cp.imagen_plan_ruta)::varchar,  -- 🔥 FIX AQUÍ

    0::numeric,

    p_id_destino::varchar

FROM calculo_pax cp
ORDER BY precio_total;

END;
$BODY$;

