        pl.nombre_plan,
        ((p.precio_individual * menor_setenta) +
        ((p.precio_individual * (p.precio_mayor_setenta / 100)) * mayor_setenta) +
        (p.precio_individual * mayor_setenta)) * COALESCE(tipo_cambio, 1) AS precio_total,
